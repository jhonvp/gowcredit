# Optional overrides. Defaults in docker-compose.yml work out of the box.
LOG_LEVEL=info
LOG_PRETTY=true
# LLM tiers (ADR 0004). replay (default) answers from fixtures/llm and needs no key.
# record = call the API for requests without a fixture and save them; live = call, don't save; off = T0 only.
ANTHROPIC_API_KEY=
LLM_MODE=replay
# Pinned defaults: claude-haiku-5-5 (T3) and claude-opus-5-5 (T4)
# LLM_MODEL_BASIC=
# LLM_MODEL_BIG=
# Observability profile (docker compose --profile observability up)
DD_TRACE_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
# Auth hardening (ADR 0005). Login attempts per minute for one email; one IP gets 5x this.
LOGIN_ATTEMPTS_PER_MINUTE=10
# Proxies in front of the API whose X-Forwarded-For is trusted (0 locally; 2 in AWS: CloudFront + ALB).
TRUST_PROXY_HOPS=0
# JWT lifetime in seconds (8 h). The user and role are re-read on every request anyway.
# JWT_TTL_SECONDS=28800
# Analysts can generate the owner's magic link in the case view (docker-compose.yml sets true locally).
# OWNER_LINK_SHARING=true
